<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body>
    <header>
      <nav>
        <ul>
          <li><a href="/new">Add New Username</a></li>
          <li><a href="/delete">Delete All Usernames</a></li>
        </ul>
      </nav>
      <form action="/" method="get" role="search" autocomplete="off">
        <div>
          <input type="search" id="search" name="search" />
          <button>Search</button>
        </div>
      </form>
    </header>
    <main>
      <h1><%= locals.title %></h1>
      <ul>
        <% if (locals.usernames) { %>
        <% usernames.forEach((username) => { %>
        <li><%= username.username %></li>
        <% }) %>
        <% } %>
      </ul>
    </main>
  </body>
</html>
